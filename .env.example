# ---- chain ----
BASE_SEPOLIA_RPC_URL=
CHAIN_ID=84532

# ---- keys (one job per key; never a personal key; never in a client bundle) ----
DEPLOYER_PRIVATE_KEY=              # owner of the four contracts (disclosed operator powers)
RELAYER_PRIVATE_KEY=               # holds the float; post / registerFor / claimFor / releaseClaimFor / submitFor / approve-dispute on behalf; x402 payTo
ATTESTATION_VERIFIER_PRIVATE_KEY=  # signs EIP-712 attestations; never sends a tx
ABUSEMARK_SIGNER_PRIVATE_KEY=      # AbuseMark.mark only
BUYER_PRIVATE_KEY=                 # the demo agent (local MCP, demo:run, examples/agent.ts); allowlisted
CLI_WORKER_PRIVATE_KEY=            # the seeded CLI worker
TREASURY_ADDRESS=                  # receives fees
BUYER_AGENT_ID=                    # the demo agent's ERC-8004 id (T-32 fills it)
BASESCAN_API_KEY=                  # forge verify-contract
FORCE_REDEPLOY=0                   # Deploy.s.sol re-run guard override

# ---- deployed addresses (filled by T-14 from contracts/deployments/base-sepolia.json) ----
WORKER_REGISTRY_ADDRESS=
TASK_ESCROW_ADDRESS=
REPUTATION_ADDRESS=
ABUSEMARK_ADDRESS=
USDC_ADDRESS=                      # Base Sepolia USDC (FiatTokenV2_2)
ERC8004_IDENTITY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713

# ---- World ID ----
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=              # server-side only (signRequest)
WORLD_ACTION=legwork-worker
WORLD_ENV=staging
WORLD_CREDENTIAL_LEVEL=selfie      # selfie | orb  (set by the S2' spike)
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_CREDENTIAL_LEVEL=selfie

# ---- payments ----
PAYMENT_MODE=x402                  # x402 | direct (set by the S3 spike)
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532

# ---- Supabase (Postgres + Storage) ----
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PROOF_BUCKET=proofs

# ---- The Graph ----
SUBGRAPH_QUERY_URL=
GRAPH_API_KEY=
GRAPH_DEPLOY_KEY=
SUBGRAPH_SLUG=legwork-base-sepolia
NEXT_PUBLIC_SUBGRAPH_QUERY_URL=

# ---- Anthropic (product key; $40 cap set in the Console) ----
ANTHROPIC_API_KEY=                 # read ONLY in packages/screening/src/classifier/live.ts and scripts/**
CLASSIFIER_MODEL=claude-opus-5
LIVE_LLM=0

# ---- API ----
API_BASE_URL=
DASHBOARD_URL=
MINIAPP_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_ADMIN_UI=0                # 1 shows the dashboard admin panel; the key is pasted at runtime, never an env
ADMIN_API_KEY=
SWEEP_SECRET=
SESSION_SECRET=
PROOF_URL_SECRET=
DEMO_DISPUTE_WINDOW_S=120
LONGPOLL_MAX_S=50
DATA_MODE=live                     # live | demo  (demo renders a visible "DEMO DATA" chip)
