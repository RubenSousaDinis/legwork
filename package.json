{
  "name": "legwork",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:push": "pnpm --filter @legwork/api db:push",
    "abi:gen": "bash contracts/script/abi-gen.sh",
    "osm:extract": "tsx scripts/osm-extract.ts",
    "demo:run": "echo 'not yet \u2014 T-29' && exit 1",
    "demo:reset": "echo 'not yet \u2014 T-29' && exit 1",
    "inserts": "echo 'not yet \u2014 T-44' && exit 1",
    "e2e:anvil": "echo 'not yet \u2014 T-36' && exit 1",
    "claim": "bash scripts/claim.sh",
    "release": "bash scripts/release.sh",
    "claims": "bash scripts/claims.sh",
    "docs:gen": "pnpm --filter @legwork/shared exec tsx scripts/gen-docs.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@x402/core": "catalog:",
    "@x402/evm": "catalog:",
    "@x402/fetch": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:"
  }
}
