{
  "name": "@legwork/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src test --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "db:push": "NODE_OPTIONS='--require ./scripts/drizzle-bigint-json.cjs' drizzle-kit push",
    "drizzle:generate": "NODE_OPTIONS='--require ./scripts/drizzle-bigint-json.cjs' drizzle-kit generate",
    "drizzle:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@legwork/chain": "workspace:*",
    "@legwork/shared": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "@worldcoin/idkit-core": "catalog:",
    "@worldcoin/minikit-js": "catalog:",
    "drizzle-orm": "catalog:",
    "exifr": "catalog:",
    "fast-json-stable-stringify": "catalog:",
    "jose": "catalog:",
    "next": "catalog:",
    "ngeohash": "catalog:",
    "pino": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "msw": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
